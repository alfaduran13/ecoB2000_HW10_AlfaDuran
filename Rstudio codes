x_train <- as.matrix(sobj$data[, -1])
y_train <- sobj$data$he_more_than_7yrs_than_her
x_test <- as.matrix(s_dat_test[, colnames(x_train), drop = FALSE])

set.seed(54321)
model1_elasticnet <- glmnet(x_train, y_train, family = "binomial", alpha = 1)
plot(model1_elasticnet, label = TRUE)
cvmodel1_elasticnet <- cv.glmnet(x_train, y_train, family = "binomial", alpha = 1)
cvmodel1_elasticnet$lambda.min
coef(cvmodel1_elasticnet, s = "lambda.min")
pred1_elasnet <- predict(cvmodel1_elasticnet, newx = x_test, s = "lambda.min", type = "response")
pred_model1_elasnet <- pred1_elasnet > mean(pred1_elasnet)
table(pred = pred_model1_elasnet, true = y_test)

model2_elasticnet <- glmnet(x_train, y_train, family = "binomial", alpha = 0)
print(model2_elasticnet)
